#: rust/annuaire-app/data/ui/historique.blp
#: rust/annuaire-app/src/history.rs
msgid "Backups of propagations"
msgstr "Sauvegardes des propagations"

#: rust/annuaire-app/src/history.rs
msgid "Cannot read the backups"
msgstr "Impossible de lire les sauvegardes"


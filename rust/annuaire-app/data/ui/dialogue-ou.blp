using Gtk 4.0;
using Adw 1;

template $AnnuaireDialogueOU: Adw.Dialog {
  title: _("New Organizational Unit");
  content-width: 520;
  default-widget: confirm_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("Cancel");
        clicked => $cancel();
      }

      [end]
      Button confirm_button {
        label: _("Continue");
        clicked => $confirm();

        styles [
          "suggested-action",
        ]
      }
    }

    [top]
    Adw.Banner message {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow name_entry {
          title: _("Name");
          activates-default: true;
        }

        Adw.EntryRow description_entry {
          title: _("Description");
        }

        Adw.ActionRow location_row {
          title: _("Location");
          subtitle-selectable: true;
        }

        Adw.SwitchRow protect_switch {
          title: _("Protect from accidental deletion");
          subtitle: _("Like the Windows console: Deny Delete for Everyone, set after creation (second preview)");
          active: true;
        }
      }
    };
  };
}

using Gtk 4.0;
using Adw 1;

template $AnnuaireDialogueGroupe: Adw.Dialog {
  title: _("New Group");
  content-width: 520;
  default-widget: confirm_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("Cancel");
        clicked => $cancel();
      }

      [end]
      Button confirm_button {
        label: _("Continue");
        clicked => $confirm();

        styles [
          "suggested-action",
        ]
      }
    }

    [top]
    Adw.Banner message {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow name_entry {
          title: _("Name");
          changed => $name_changed();
        }

        Adw.EntryRow identifier_entry {
          title: _("Account name (sAMAccountName)");
          input-hints: no_spellcheck;
        }

        Adw.EntryRow description_entry {
          title: _("Description");
        }

        Adw.ActionRow location_row {
          title: _("Location");
          subtitle-selectable: true;
        }
      }

      Adw.PreferencesGroup {
        Adw.ComboRow scope_combo {
          title: _("Scope");

          model: StringList {
            strings [
              _("Global"),
              _("Domain local"),
              _("Universal"),
            ]
          };
        }

        Adw.SwitchRow security_switch {
          title: _("Security group");
          subtitle: _("Otherwise a distribution group (mailing lists)");
          active: true;
        }
      }
    };
  };
}

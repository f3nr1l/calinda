//
// Onglet « Stratégie » de la fiche d'un utilisateur ou d'un ordinateur (J5.7) : quelles GPO
// s'appliquent à ce compte, par priorité, et pourquoi les autres ne s'appliquent pas.
// Les lignes sont remplies par ui/strategie.py (textes de vue/gpo.py).
using Gtk 4.0;
using Adw 1;

template $AnnuairePageStrategie: Adw.Bin {
  child: Stack state {
    transition-type: crossfade;

    StackPage {
      name: "chargement";

      child: Spinner {
        spinning: true;
        halign: center;
        valign: center;
        width-request: 32;
        height-request: 32;
      };
    }

    StackPage {
      name: "erreur";

      child: Adw.StatusPage error {
        icon-name: "dialog-warning-symbolic";

        child: Button {
          label: _("Read Again");
          halign: center;
          clicked => $reload();

          styles [
            "pill",
          ]
        };
      };
    }

    StackPage {
      name: "contenu";

      child: Adw.PreferencesPage {
        Adw.PreferencesGroup summary_group {
          title: _("Resultant Policy");

          header-suffix: Button {
            icon-name: "view-refresh-symbolic";
            tooltip-text: _("Recalculate");
            valign: center;
            clicked => $reload();

            accessibility {
              label: _("Recalculate the policy");
            }

            styles [
              "flat",
            ]
          };

          ListBox remarks_list {
            selection-mode: none;

            accessibility {
              label: _("Notes on the calculation");
            }

            styles [
              "boxed-list",
            ]
          }
        }

        // Traitement en boucle (loopback) : mode d'un ordinateur ; pour un utilisateur, la
        // stratégie sur l'ordinateur saisi.
        Adw.PreferencesGroup loopback_group {
          title: _("Loopback Processing");

          Adw.EntryRow computer_entry {
            title: _("Log on to the computer");
            show-apply-button: true;
            apply => $loopback();
            entry-activated => $loopback();
          }

          Adw.ActionRow loopback_row {
            title: _("Mode");
            subtitle-lines: 0;

            styles [
              "property",
            ]
          }
        }

        Adw.PreferencesGroup applied_group {
          title: _("Applied GPOs, from highest to lowest precedence");

          ListBox applied_list {
            selection-mode: none;

            accessibility {
              label: _("Applied GPOs");
            }

            styles [
              "boxed-list",
            ]
          }
        }

        Adw.PreferencesGroup denied_group {
          title: _("GPOs not applied");
          description: _("Filtered out, or whose link does not count for this account.");

          ListBox denied_list {
            selection-mode: none;

            accessibility {
              label: _("GPOs not applied");
            }

            styles [
              "boxed-list",
            ]
          }
        }
      };
    }
  };
}

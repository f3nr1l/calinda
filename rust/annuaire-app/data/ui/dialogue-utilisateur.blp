using Gtk 4.0;
using Adw 1;

template $AnnuaireDialogueUtilisateur: Adw.Dialog {
  title: _("New User");
  content-width: 520;
  default-widget: confirm_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("Cancel");
        clicked => $cancel();
      }

      [end]
      Button confirm_button {
        label: _("Continue");
        clicked => $confirm();

        styles [
          "suggested-action",
        ]
      }
    }

    [top]
    Adw.Banner message {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow given_name_entry {
          title: _("First name");
          changed => $names_changed();
        }

        Adw.EntryRow name_entry {
          title: _("Name");
          changed => $names_changed();
        }

        Adw.EntryRow full_name_entry {
          title: _("Full name (CN)");
        }
      }

      Adw.PreferencesGroup {
        title: _("Account");

        Adw.EntryRow identifier_entry {
          title: _("Account name (sAMAccountName)");
          input-hints: no_spellcheck;
          changed => $identifier_changed();
        }

        Adw.EntryRow upn_entry {
          title: _("User logon name (UPN)");
          input-hints: no_spellcheck;
        }

        Adw.ActionRow location_row {
          title: _("Location");
          subtitle-selectable: true;
        }
      }

      Adw.PreferencesGroup {
        title: _("Initial password");
        description: _("Sent to the domain controller over the encrypted connection, then forgotten: it is neither stored nor logged, and the preview hides it.");

        Adw.PasswordEntryRow password_entry {
          title: _("Password");
        }

        Adw.PasswordEntryRow confirmation_entry {
          title: _("Confirm password");
          activates-default: true;
        }

        Adw.SwitchRow change_switch {
          title: _("User must change password at next logon");
          active: true;
        }

        Adw.SwitchRow enable_switch {
          title: _("Enable the account");
          active: true;
        }
      }
    };
  };
}

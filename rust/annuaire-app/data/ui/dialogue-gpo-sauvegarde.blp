//
// Sauvegarde d'une GPO (J5.6) : archive datée (objet, objets dessous, dossier SYSVOL avec
// ACL) écrite dans le dossier choisi. Rien n'est modifié dans l'annuaire.
using Gtk 4.0;
using Adw 1;

template $AnnuaireDialogueGpoSauvegarde: Adw.Dialog {
  focus-widget: folder_entry;
  title: _("Back Up the GPO");
  content-width: 560;
  default-widget: back_up_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle title {
        title: _("Back Up the GPO");
      };

      [start]
      Button cancel_button {
        label: _("Cancel");
        clicked => $cancel();
      }

      [end]
      Stack button_stack {
        StackPage {
          name: "bouton";

          child: Button back_up_button {
            label: _("Back Up");
            clicked => $back_up();

            styles [
              "suggested-action",
            ]
          };
        }

        StackPage {
          name: "attente";

          child: Spinner {
            spinning: true;

            accessibility {
              label: _("Backup in progress");
            }
          };
        }
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        description: _("A dated archive: the directory object (attributes, permissions, child objects) and its whole SYSVOL folder, files and permissions included, read on the PDC emulator. The format is described in ADR 0012.");

        Adw.EntryRow folder_entry {
          title: _("Backup folder");
          activates-default: true;

          [suffix]
          Button {
            icon-name: "folder-open-symbolic";
            tooltip-text: _("Choose the folder");
            valign: center;
            clicked => $choose();

            accessibility {
              label: _("Choose the folder");
            }

            styles [
              "flat",
            ]
          }
        }
      }
    };
  };
}

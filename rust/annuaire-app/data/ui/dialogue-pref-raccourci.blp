//
// Raccourci d'une GPO (préférence Shortcuts.xml, J7.6) : emplacement et nom, cible (fichier ou URL), arguments, fenêtre, icône, ciblage et options communes.
using Gtk 4.0;
using Adw 1;

template $AnnuaireDialoguePrefRaccourci: Adw.Dialog {
  title: _("Shortcut");
  content-width: 600;
  content-height: 760;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle title {
        title: _("Shortcut");
      };

      [start]
      Button {
        label: _("Cancel");
        clicked => $cancel();
      }

      [end]
      Button continue_button {
        label: _("Continue");
        clicked => $next();

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.ComboRow action_combo {
          title: _("Action");
          use-subtitle: true;
          notify::selected => $changed();

          model: StringList {
            strings [
              _("Create"),
              _("Replace"),
              _("Update"),
              _("Delete"),
            ]
          };
        }
      }

      Adw.PreferencesGroup {
        title: _("Shortcut");

        Adw.EntryRow path_entry {
          title: _("Location and name (%DesktopDir%\\Name)");
          changed => $changed();
        }

        Adw.ComboRow kind_combo {
          title: _("Target type");
          use-subtitle: true;
          notify::selected => $changed();

          model: StringList {
            strings [
              _("File System Object"),
              _("URL"),
            ]
          };
        }

        Adw.EntryRow target_entry {
          title: _("Target path");
          changed => $changed();
        }

        Adw.EntryRow arguments_entry {
          title: _("Arguments");
          changed => $changed();
        }

        Adw.EntryRow start_in_entry {
          title: _("Start in");
          changed => $changed();
        }

        Adw.ComboRow window_combo {
          title: _("Run");
          use-subtitle: true;
          notify::selected => $changed();

          model: StringList {
            strings [
              _("Normal window"),
              _("Minimized"),
              _("Maximized"),
            ]
          };
        }

        Adw.EntryRow comment_entry {
          title: _("Comment");
          changed => $changed();
        }

        Adw.EntryRow icon_entry {
          title: _("Icon file path");
          changed => $changed();
        }

        Adw.EntryRow index_entry {
          title: _("Icon index");
          changed => $changed();
        }
      }

      Adw.PreferencesGroup targets_group {
        title: _("Targeting");
        description: _("Without a filter, the item applies to everyone who receives the GPO.");

        [header-suffix]
        MenuButton target_button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Add a filter");
          menu-model: targets_menu;

          accessibility {
            label: _("Add a targeting filter");
          }

          styles [
            "flat",
          ]
        }

        ListBox targets_list {
          selection-mode: none;

          accessibility {
            label: _("Targeting filters, in order");
          }

          styles [
            "boxed-list",
          ]
        }
      }

      Adw.PreferencesGroup {
        title: _("Common options");

        Adw.EntryRow description_entry {
          title: _("Description");
          changed => $changed();
        }

        Adw.SwitchRow stop_switch {
          title: _("Stop processing items in this extension if an error occurs");
          title-lines: 0;
          notify::active => $changed();
        }

        Adw.SwitchRow context_switch {
          title: _("Run in logged-on user's security context");
          title-lines: 0;
          notify::active => $changed();
        }

        Adw.SwitchRow remove_switch {
          title: _("Remove this item when it is no longer applied");
          subtitle: _("Requires the “Replace” action");
          title-lines: 0;
          notify::active => $changed();
        }

        Adw.SwitchRow disabled_switch {
          title: _("Disable this item");
          notify::active => $changed();
        }
      }

      Adw.PreferencesGroup {
        Label message {
          wrap: true;
          xalign: 0;
          visible: false;

          styles [
            "error",
          ]
        }
      }
    };
  };
}

menu targets_menu {
  section {
    item {
      label: _("Security Group…");
      action: "dialogue.cible";
      target: "FilterGroup";
    }

    item {
      label: _("Organizational Unit…");
      action: "dialogue.cible";
      target: "FilterOrgUnit";
    }

    item {
      label: _("Computer Name…");
      action: "dialogue.cible";
      target: "FilterComputer";
    }

    item {
      label: _("User…");
      action: "dialogue.cible";
      target: "FilterUser";
    }
  }
}
